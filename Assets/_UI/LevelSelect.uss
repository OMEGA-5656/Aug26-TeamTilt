/* ─── LevelSelect.uss — fully self-contained (no @import) ─── */

/* ── Shared tokens ─────────────────────────────────────────── */
:root {
    --color-bg:     #FFF5E4;
    --color-accent: #FF7043;
    --color-accent-dark: #E64A19;
    --color-text:   #3E2723;
    --radius:       16px;
}

/* ── Full-screen root ───────────────────────────────────────── */
.root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: var(--color-bg);
    width: 100%;
    height: 100%;
}

/* ── Card ───────────────────────────────────────────────────── */
.card {
    background-color: #FFFBF5;
    border-radius: var(--radius);
    border-width: 2px;
    border-color: rgba(255, 112, 67, 0.3);
    padding: 32px;
    align-items: center;
}

.level-select-card {
    width: 92%;
    max-width: 700px;
    min-height: 480px;
}

/* ── Title ──────────────────────────────────────────────────── */
.title {
    font-size: 32px;
    color: var(--color-accent);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 4px;
    margin-bottom: 8px;
}

/* ── Status line ────────────────────────────────────────────── */
.status {
    font-size: 16px;
    color: var(--color-text);
    -unity-text-align: middle-center;
    margin-bottom: 20px;
    opacity: 0.75;
}

/* ── 2×3 Grid ───────────────────────────────────────────────── */
.level-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
    flex-grow: 1;
}

/* ── Level Tile ─────────────────────────────────────────────── */
.level-tile {
    width: 28%;
    margin: 10px;
    background-color: var(--color-accent);
    border-radius: 12px;
    border-width: 3px;
    border-color: var(--color-accent-dark);
    align-items: center;
    justify-content: center;
    min-height: 100px;
    min-width: 90px;
    max-width: 150px;
    transition-duration: 0.15s;
}

.level-tile-locked {
    background-color: rgba(62, 39, 35, 0.08);
    border-color: rgba(62, 39, 35, 0.15);
}

.level-tile-clickable:hover {
    background-color: #FF8A65;
    scale: 1.05 1.05;
}

.level-number {
    font-size: 40px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.level-tile-locked .level-number {
    color: rgba(62, 39, 35, 0.3);
}

.lock-icon {
    font-size: 20px;
    -unity-text-align: middle-center;
}

/* ── Client Wait Overlay ────────────────────────────────────── */
.client-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(255, 245, 228, 0.85);
    border-radius: var(--radius);
    align-items: center;
    justify-content: center;
}

.overlay-text {
    font-size: 20px;
    color: var(--color-accent);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
