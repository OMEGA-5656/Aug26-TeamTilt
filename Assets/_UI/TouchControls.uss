/* ── TouchControls.uss — Ergonomic Mobile Controls ── */

.touch-root {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 220px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    padding: 20px 24px;
}

.side-controls {
    flex-direction: row;
    align-items: flex-end;
}

/* ── Hitboxes (Invisible Touch Targets) ───────────────────── */
.hitbox {
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0); 
}

.action-hitbox {
    width: 100px;
    height: 100px;
}

.dpad-hitbox {
    width: 80px;
    height: 100px;
}

/* visual-btn handles the graphic, ignoring its own touch 
   so the padding of the hitbox dictates the hit area */
.visual-btn {
    pointer-events: none; 
}


/* ── D-Pad Visuals ─────────────────────────────────────────── */
.dpad {
    flex-direction: row;
    align-items: center;
}

.dpad-btn {
    width: 60px; /* Standard Size */
    height: 60px;
    border-radius: 30px;
    background-color: rgba(255, 255, 255, 0.20);
    border-color: rgba(255, 255, 255, 0.38);
    border-width: 2px;
    align-items: center;
    justify-content: center;
    transition-duration: 0.06s;
}

.hitbox:active .dpad-btn {
    background-color: rgba(255, 112, 67, 0.55);
    border-color: #FF7043;
    scale: 0.94 0.94;
}

/* ── Action Buttons Visuals ────────────────────────────────── */
.right-controls {
    flex-direction: row;
    align-items: flex-end;
    gap: 8px; /* Safe spacing to prevent cross-tapping */
}

.action-btn {
    align-items: center;
    justify-content: center;
    border-radius: 50px;
    border-width: 2px;
    transition-duration: 0.06s;
}

.hitbox:active .action-btn {
    scale: 0.92 0.92;
}

.jump-btn {
    width: 72px; /* High Priority Size */
    height: 72px;
    background-color: rgba(255, 112, 67, 0.80);
    border-color: #FF7043;
}

.dash-btn {
    width: 60px; /* Standard Size */
    height: 60px;
    background-color: rgba(255, 255, 255, 0.20);
    border-color: rgba(255, 255, 255, 0.38);
}

.btn-label {
    font-size: 16px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.dpad-btn .btn-label {
    font-size: 24px;
}
