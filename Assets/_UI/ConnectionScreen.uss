@import url("MainMenu.uss");

.connection-card {
    width: 88%;
    max-width: 600px;
    padding: 32px;
}

.section-divider {
    width: 100%;
    height: 2px;
    background-color: var(--color-accent-dim);
    margin: 20px 0;
}

.ip-label {
    font-size: 14px;
    color: var(--color-text-muted);
    letter-spacing: 2px;
    margin-bottom: 8px;
}

.ip-field {
    width: 100%;
    margin-bottom: 16px;
    border-radius: var(--radius);
    border-color: var(--color-accent);
    border-width: 2px;
    height: 52px;
}

.ip-field > .unity-text-field__input {
    background-color: rgba(255, 112, 67, 0.06);
    border-color: var(--color-accent);
    border-radius: var(--radius);
    color: var(--color-text);
    padding: 12px;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
