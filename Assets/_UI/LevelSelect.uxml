<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/_UI/LevelSelect.uss" />

    <ui:VisualElement name="root" class="root">
        <ui:VisualElement name="card" class="card level-select-card">

            <ui:Label name="title-label" text="SELECT LEVEL" class="title" />
            <ui:Label name="status-label" text="Pick a level to start!" class="status" />

            <!-- 2x3 grid populated from code -->
            <ui:VisualElement name="level-grid" class="level-grid" />

            <!-- Shown on non-host clients -->
            <ui:VisualElement name="client-overlay" class="client-overlay">
                <ui:Label text="Waiting for host to pick a level..." class="overlay-text" />
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
