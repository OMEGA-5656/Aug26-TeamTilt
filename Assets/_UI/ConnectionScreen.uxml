<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/_UI/ConnectionScreen.uss" />

    <ui:VisualElement name="root" class="root">
        <ui:VisualElement name="card" class="card">
            <ui:Label name="title-label" text="CONNECT" class="title" />

            <!-- Status feedback -->
            <ui:Label name="status-label" text="Choose to host or join a game." class="status" />

            <!-- Host section -->
            <ui:VisualElement name="host-section" class="section">
                <ui:Label text="HOST A GAME" class="section-title" />
                <ui:Button name="host-btn" text="START HOST" class="btn btn-primary" />
            </ui:VisualElement>

            <!-- Divider -->
            <ui:VisualElement class="divider">
                <ui:Label text="OR" class="divider-label" />
            </ui:VisualElement>

            <!-- Join section -->
            <ui:VisualElement name="join-section" class="section">
                <ui:Label text="JOIN A GAME" class="section-title" />
                <ui:TextField name="ip-field" label="" value="192.168.1.1" class="ip-field" />
                <ui:Button name="join-btn" text="JOIN" class="btn btn-secondary" />
            </ui:VisualElement>

            <!-- Back -->
            <ui:Button name="back-btn" text="BACK" class="btn btn-back" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
